<Window x:Class="MorseDecoder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Morse CW Decoder"
        Width="1280"
        Height="780"
        MinWidth="960"
        MinHeight="620"
        Background="{StaticResource PageBackgroundBrush}"
        Icon="Assets/MorseDecoder.ico"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="2*" MinHeight="220" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" MinHeight="210" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="输入设备"
                       Margin="0,0,10,0"
                       Foreground="{StaticResource SecondaryTextBrush}" />

            <ComboBox x:Name="DeviceComboBox"
                      Grid.Column="1"
                      DisplayMemberPath="Name"
                      VerticalContentAlignment="Center" />

            <Button x:Name="StartButton"
                    Grid.Column="3"
                    Content="开始"
                    Click="StartButton_Click" />

            <Button x:Name="StopButton"
                    Grid.Column="4"
                    Content="停止"
                    IsEnabled="False"
                    Click="StopButton_Click" />

            <Button x:Name="TestButton"
                    Grid.Column="5"
                    Content="测试信号"
                    Click="TestButton_Click" />

            <Button Grid.Column="6"
                    Content="清空"
                    Click="ClearButton_Click" />

            <TextBlock Grid.Column="8"
                       Text="48 kHz / 16-bit / mono"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </Grid>

        <Border Grid.Row="2"
                Background="#05090D"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Image x:Name="WaterfallImage"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="LowQuality" />

                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="8"
                        Padding="6,3"
                        Background="#AA101820"
                        CornerRadius="3">
                    <TextBlock Text="3900 Hz"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Border>

                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="8"
                        Padding="6,3"
                        Background="#AA101820"
                        CornerRadius="3">
                    <TextBlock Text="80 Hz"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="10,8"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="信号轨迹"
                                   FontWeight="SemiBold" />
                    </Border>

                    <DataGrid x:Name="TracksGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding Tracks}"
                              SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              SelectionChanged="TracksGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"
                                                Binding="{Binding Id}"
                                                Width="36" />
                            <DataGridTextColumn Header="Hz"
                                                Binding="{Binding FrequencyHz, StringFormat={}{0:F1}}"
                                                Width="70" />
                            <DataGridTextColumn Header="WPM"
                                                Binding="{Binding Wpm, StringFormat={}{0:F1}}"
                                                Width="60" />
                            <DataGridTextColumn Header="dB"
                                                Binding="{Binding SignalStrengthDb, StringFormat={}{0:F1}}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="10,8"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock x:Name="SelectedTrackHeader"
                                   Text="请选择一条信号轨迹"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Border>

                    <TextBox x:Name="TranscriptTextBox"
                             Grid.Row="1"
                             Margin="8"
                             Padding="12"
                             Background="#0B1117"
                             Foreground="{StaticResource PrimaryTextBrush}"
                             BorderBrush="#1D2A35"
                             FontFamily="Consolas"
                             FontSize="17"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>

        <StatusBar Grid.Row="6"
                   Background="#101820"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   BorderBrush="{StaticResource PanelBorderBrush}"
                   BorderThickness="1">
            <StatusBarItem>
                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="等待开始" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
